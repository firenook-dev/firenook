{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "react",
    "unicorn",
    "oxc"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "env": {
    "browser": true,
    "es2024": true
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "no-console": "warn",
    "no-underscore-dangle": [
      "off"
    ]
  },
  "ignorePatterns": [
    "dist/",
    ".design-system/",
    "node_modules/",
    "src/routeTree.gen.ts",
    "src/api/generated/",
    "playwright-report/",
    "test-results/"
  ],
  "overrides": [
    {
      "files": [
        "scripts/**",
        "e2e/**",
        "design-system/kit/scripts/**"
      ],
      "rules": {
        "no-console": "off",
        "no-await-in-loop": "off"
      }
    }
  ]
}
