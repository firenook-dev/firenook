{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "env": {
    "browser": true,
    "es2024": true
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "no-console": "warn",
    "no-underscore-dangle": ["off"],
    "no-restricted-globals": [
      "error",
      {
        "name": "EventSource",
        "message": "Subscribe to a topic with useLiveTopic (src/lib/live); the console holds one live connection per browser."
      }
    ]
  },
  "ignorePatterns": [
    "dist/",
    ".design-system/",
    "node_modules/",
    "src/routeTree.gen.ts",
    "src/api/generated/",
    "playwright-report/",
    "test-results/"
  ],
  "overrides": [
    {
      "files": ["src/lib/live/**", "src/firestore/live.ts", "src/firestore/rules-page/api.ts"],
      "rules": {
        "no-restricted-globals": "off"
      }
    },
    {
      "files": ["scripts/**", "e2e/**", "design-system/kit/scripts/**"],
      "rules": {
        "no-console": "off",
        "no-await-in-loop": "off"
      }
    }
  ]
}
