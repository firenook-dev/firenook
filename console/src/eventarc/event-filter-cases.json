{
  "note": "The Eventarc event filter's golden cases (crates/console-front/src/compute/filters.rs EVENT_FIELDS, console/src/eventarc/filters.ts). Both sides parse and validate every text against these fields and must give exactly this result or this error, message and UTF-16 span included.",
  "regex": false,
  "fields": [
    {
      "key": "type",
      "kind": "exact",
      "help": "Event type; end with * for a prefix"
    },
    {
      "key": "source",
      "kind": "exact",
      "help": "CloudEvent source"
    },
    {
      "key": "subject",
      "kind": "exact",
      "help": "CloudEvent subject"
    },
    {
      "key": "publisher",
      "kind": "exact",
      "help": "Extension instance that published it"
    },
    {
      "key": "origin",
      "kind": "enum",
      "help": "Who published it",
      "values": ["console", "replay", "app"]
    },
    {
      "key": "delivery",
      "kind": "enum",
      "help": "What became of it",
      "values": ["delivered", "filtered", "unheard", "failed", "pending"]
    },
    {
      "key": "at",
      "kind": "time",
      "help": "When it arrived"
    }
  ],
  "cases": [
