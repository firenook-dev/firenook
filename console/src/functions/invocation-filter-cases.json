{
  "note": "The invocation filter golden cases (crates/console-front/src/compute/filters.rs INVOCATION_FIELDS, console/src/functions/filters.ts invocationFields). Both sides parse and validate every text against these fields and must give exactly this result or this error, message and UTF-16 span included. The engine applies the same filter to GET /functions/invocations and the functions.events topic.",
  "regex": false,
  "fields": [
    {
      "key": "function",
      "aliases": ["fn"],
      "kind": "exact",
      "help": "Function id, like us-central1-api"
    },
    {
      "key": "codebase",
      "kind": "exact",
      "help": "Codebase or extension instance"
    },
    {
      "key": "kind",
      "kind": "enum",
      "help": "How the function is triggered",
      "values": [
        "http",
        "callable",
        "firestore",
        "storage",
        "auth",
        "pubsub",
        "schedule",
        "eventarc",
        "tasks",
        "blocking",
        "alerts",
        "database",
        "other"
      ]
    },
    {
      "key": "topic",
      "kind": "exact",
      "help": "Pub/Sub or schedule topic, by name or full name"
    },
    {
      "key": "queue",
      "kind": "exact",
      "help": "Cloud Tasks queue key, like demo-project-us-central1-resize"
    },
    {
      "key": "outcome",
      "kind": "enum",
      "help": "Succeeded, failed, skipped or still running",
      "values": ["succeeded", "failed", "skipped", "running"]
    },
    {
      "key": "origin",
      "kind": "enum",
      "help": "Who made the call",
      "values": ["console", "replay", "emulator", "client"]
    },
    {
      "key": "status",
      "kind": "number",
      "help": "HTTP status the function answered with"
    },
    {
      "key": "took",
      "kind": "duration",
      "help": "How long it ran, like >200ms"
    },
    {
      "key": "at",
      "kind": "time",
      "help": "When it started"
    },
    {
      "key": "is",
      "kind": "enum",
      "help": "A cold start or a replay",
      "values": ["cold", "replay"]
    }
  ],
  "cases": [
