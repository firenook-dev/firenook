            { "providerId": "password", "email": "ada@example.test", "rawId": "ada@example.test" }
          ],
          "createdAt": "1760248931000",
          "lastLoginAt": "1760248931000"
        },
        "signInMethod": "password",
        "iat": 1760248931,
        "eventId": "q0S5UqTmZtA3Y0bS8mMHNw"
      },
      "payload": {
        "iss": "https://securetoken.google.com/demo-x",
