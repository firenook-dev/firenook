{
  "note": "The Logs filter's golden cases (crates/console-front/src/observe/fields.rs, console/src/logs/fields.ts). Both sides parse and validate every text against these fields, the Logs field set, and must give exactly this result or this error, message and UTF-16 span included. Logs is the one field set that takes /regex/ items.",
  "regex": true,
  "fields": [
    {
      "key": "level",
      "aliases": ["severity"],
      "kind": "enum",
      "help": "How serious the line is",
      "values": ["debug", "info", "warn", "error"]
    },
    {
      "key": "service",
      "aliases": ["emulator"],
      "kind": "enum",
      "help": "The emulator that wrote it",
      "values": ["hub", "firestore", "auth", "storage", "functions", "pubsub", "eventarc", "tasks"]
    },
    {
      "key": "function",
      "aliases": ["fn"],
      "kind": "exact",
      "help": "Functions trigger id; end with * for a prefix"
    },
    {
      "key": "instance",
      "aliases": ["ext", "extension"],
      "kind": "exact",
      "help": "Extension instance"
    },
    {
      "key": "codebase",
      "kind": "exact",
      "help": "Functions codebase"
    },
    {
      "key": "execution",
      "aliases": ["exec"],
      "kind": "exact",
      "help": "One function invocation"
    },
    {
      "key": "kind",
      "kind": "exact",
      "help": "What happened, like function.failed; end with * for a prefix"
    },
    {
      "key": "is",
      "kind": "enum",
      "help": "Problems, engine internals or markers",
      "values": ["problem", "internal", "marker"]
    },
    {
      "key": "payload",
      "kind": "path",
      "help": "A field of the structured payload; * for any value",
      "prefixes": ["payload."]
    }
  ],
  "cases": [
