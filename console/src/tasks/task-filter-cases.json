{
  "note": "The task filter's golden cases (crates/console-front/src/messaging/tasks/filters.rs, console/src/tasks). Both sides parse and validate every text against these fields and must give exactly this result or this error, message and UTF-16 span included.",
  "regex": false,
  "fields": [
    {
      "key": "name",
      "aliases": ["id"],
      "kind": "exact",
      "help": "Task name, full or short (a trailing * matches the start)"
    },
    {
      "key": "is",
      "kind": "enum",
      "help": "Named by the emulator, or enqueued from the console",
      "values": ["generated", "console"]
    }
  ],
  "cases": [
    {
      "name": "empty",
      "text": "",
      "ok": {}
    },
    {
      "name": "card",
      "text": "card",
      "ok": {
        "words": [
          {
            "text": "card",
            "negated": false,
            "from": 0,
            "to": 4
          }
        ]
      }
    },
    {
      "name": "name-order-1",
      "text": "name:order-1",
      "ok": {
        "terms": [
          {
            "key": "name",
            "op": "eq",
            "value": "order-1",
            "negated": false,
            "from": 0,
            "to": 12
          }
        ]
      }
    },
    {
      "name": "name-order",
      "text": "name:order-*",
      "ok": {
        "terms": [
          {
            "key": "name",
            "op": "eq",
            "value": "order-*",
            "negated": false,
            "from": 0,
            "to": 12
          }
        ]
      }
    },
    {
