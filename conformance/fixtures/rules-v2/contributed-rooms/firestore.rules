rules_version = '2';

// Synthetic ruleset contributed for firenook-dev/firenook#156. Collections and
// fields are invented; the language features are the ones a consumer's real
// rulesets use.

// A function outside the service block.
function signedIn() {
  return request.auth != null;
}

service cloud.firestore {
  match /databases/{database}/documents {

    // The conditional operator inside a function (#138).
    function isLead() {
      return (request.auth != null ? request.auth.token.role : 'guest') == 'lead';
    }

    function isMember(roomId) {
      return signedIn()
        && exists(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid));
    }

    match /rooms/{roomId} {
      allow get: if isMember(roomId);
      allow list: if signedIn() && resource.data.visibility == 'open';

      allow create: if isLead()
        && request.resource.data.keys().hasOnly(['title', 'visibility', 'created', 'note'])
        && request.resource.data.keys().hasAll(['title', 'visibility', 'created'])
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 40
        && request.resource.data.visibility in ['open', 'closed']
        && request.resource.data.created == request.time;

      // resource != null first: a create has no resource, and diff() on it is
      // an evaluation error rather than a verdict.
      allow update: if isLead()
        && resource != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'note']);

      allow delete: if false;

      match /members/{uid} {
        allow get: if signedIn() && uid == request.auth.uid;
        allow list: if isMember(roomId);
        allow write: if isLead();
      }

      match /entries/{entryId} {
        allow get: if isMember(roomId);

        // A field check in the proof of a list query (#154).
        allow list: if isMember(roomId) && 'open' in resource.data;

        // get(key, default) on the payload.
        allow create: if isMember(roomId)
          && request.resource.data.get('quantity', 0) is int
          && request.resource.data.get('quantity', 0) <= 100;

        // A lookup of the parent document.
        allow update: if isMember(roomId)
          && get(/databases/$(database)/documents/rooms/$(roomId)).data.visibility == 'open';

        allow delete: if isLead();
      }
    }

    match /marks/{markId} {
      allow get: if signedIn() && markId.matches('^[a-z0-9-]+$');
      allow list: if signedIn();
      allow create: if signedIn()
        && request.resource.data.label is string
        && request.resource.data.counter is int
        && request.resource.data.keys().hasAny(['label', 'counter']);
    }
  }
}
