rules_version = '2';
function signedIn() { return request.auth != null; }
function owns(data) { return false; }
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /tasks/{task} {
      allow get, list: if 'owner' in resource.data && resource.data.owner == request.auth.uid;
    }
    match /memos/{memo} {
      allow list: if !('secret' in resource.data);
    }
    match /posts/{post} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.author == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.author == request.auth.uid;
    }
    match /admin/{doc} {
      allow read, write: if request.auth.token.admin == true;
    }
    match /notes/{note} {
      allow get: if request.auth == null ? resource.data.public : request.auth.uid == resource.data.owner ? true : resource.data.shared;
      allow list: if resource.data.owner == request.auth.uid ? true : false;
      allow update: if resource.data.locked == true || resource.data.archived == true ? false : true;
      allow delete: if resource.data.locked ? false : true;
    }
    match /orders/{order} {
      allow read: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'staff';
    }
    match /drafts/{draft} {
      function owns(data) { return signedIn() && data.owner == request.auth.uid; }
      allow read: if owns(resource.data);
      allow create: if signedIn() && titled(request.resource.data);
    }
    match /words/{word} {
      allow get: if resource.data.text.size() == resource.data.units
        && resource.data.text[resource.data.from:resource.data.to] == resource.data.part
        && resource.data.text.upper() == resource.data.upper;
    }
    match /cards/{card} {
      allow list: if resource.data.owner == request.auth.uid;
    }
    match /slots/{slot} {
      allow list: if resource == null;
    }
    match /teams/{team} {
      allow list: if 'lead' in resource.data.roles;
    }
    match /tickets/{ticket} {
      allow list: if resource.data.status != null;
    }
    match /boxes/{box} {
      allow list: if resource.data.size.width != null;
    }
  }
}
function titled(data) { return data.title is string; }
