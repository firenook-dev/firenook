rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /open/{name} { allow read, write: if true; }
    match /deep/{allPaths=**} { allow read, write: if true; }
    match /users/{uid}/{name} { allow read, write: if request.auth != null && request.auth.uid == uid; }
  }
}
