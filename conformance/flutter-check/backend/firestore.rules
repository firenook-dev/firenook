rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /public/{id} { allow read, write: if true; }
    match /private/{id} { allow read, write: if request.auth != null; }
    match /owned/{uid} { allow read, write: if request.auth != null && request.auth.uid == uid; }
    match /{path=**}/items/{id} { allow read: if true; }
    match /groups/{g}/items/{id} { allow write: if true; }
  }
}
