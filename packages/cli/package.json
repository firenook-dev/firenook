  "engines": {"node": ">=20"},
  "license": "Apache-2.0",
  "repository": {"type": "git", "url": "git+https://github.com/firenook-dev/firenook.git", "directory": "packages/cli"},
  "bugs": {"url": "https://github.com/firenook-dev/firenook/issues"},
  "publishConfig": {"access": "public", "registry": "https://registry.npmjs.org/"},
  "optionalDependencies": {
    "@firenook/cli-darwin-arm64": "0.2.0-next.8",
