  "keywords": ["firebase", "firebase-emulator", "emulator", "firestore", "firebase-auth", "cloud-functions", "cloud-storage", "pubsub", "cloud-tasks", "local-development", "testing", "rust"],
  "homepage": "https://github.com/firenook-dev/firenook#readme",
  "type": "module",
  "bin": {"firenook": "bin/firenook.mjs"},
  "exports": {"./binary": "./src/binary.mjs"},
  "files": ["bin", "src", "release.json", "README.md", "LICENSE", "NOTICE"],
  "engines": {"node": ">=24 <25"},
  "license": "Apache-2.0",
  "repository": {"type": "git", "url": "git+https://github.com/firenook-dev/firenook.git", "directory": "packages/cli"},
  "bugs": {"url": "https://github.com/firenook-dev/firenook/issues"},
  "publishConfig": {"access": "public", "registry": "https://registry.npmjs.org/"},
  "optionalDependencies": {
    "@firenook/cli-darwin-arm64": "0.2.0-next.6",
    "@firenook/cli-darwin-x64": "0.2.0-next.6",
    "@firenook/cli-linux-x64": "0.2.0-next.6",
    "@firenook/cli-linux-arm64": "0.2.0-next.6",
    "@firenook/cli-win32-x64": "0.2.0-next.6"
  }
